<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <permission
        android:name="eu.hxreborn.gplayadblock.permission.RESTART_PLAY_STORE"
        android:protectionLevel="signature" />
    <uses-permission android:name="eu.hxreborn.gplayadblock.permission.RESTART_PLAY_STORE" />

    <queries>
        <package android:name="com.android.vending" />
    </queries>

    <application android:name="eu.hxreborn.gplayadblock.settings.GPlayAdblockApp">
        <activity
            android:name="eu.hxreborn.gplayadblock.settings.MainActivity"
            android:enableOnBackInvokedCallback="true"
            android:exported="true"
            android:theme="@style/Theme.GPlayAdblock.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="de.robv.android.xposed.category.MODULE_SETTINGS" />
            </intent-filter>
        </activity>

        <activity-alias
            android:name="eu.hxreborn.gplayadblock.LauncherAlias"
            android:enabled="true"
            android:exported="true"
            android:targetActivity="eu.hxreborn.gplayadblock.settings.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
